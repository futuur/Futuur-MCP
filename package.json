{
  "name": "@futuur/futuur-mcp",
  "version": "2.0.0",
  "description": "MCP server for Futuur prediction markets: browse events, simulate and place orders, and track positions",
  "main": "build/index.js",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "start": "node build/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "prepublishOnly": "npm run build && npm test"
  },
  "bin": {
    "futuur-mcp": "./build/index.js"
  },
  "files": [
    "build"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "futuur",
    "prediction-markets",
    "betting",
    "ai",
    "claude",
    "anthropic"
  ],
  "author": "Futuur",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/futuur/Futuur-MCP.git"
  },
  "homepage": "https://futuur.com",
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "tsx": "^4.7.1",
    "typescript": "^5.8.2",
    "vitest": "^3.2.7"
  },
  "publishConfig": {
    "access": "public"
  }
}
